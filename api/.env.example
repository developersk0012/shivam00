PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
UPLOAD_DIR=./uploads
# Keep Docker access restricted to a dedicated runner host.
# Never put Telegram bot tokens in frontend code or GitHub.

# If frontend is hosted separately, set its exact origin, e.g. https://your-site.vercel.app
FRONTEND_ORIGIN=http://localhost:5500
